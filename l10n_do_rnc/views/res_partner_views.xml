<odoo>

    <!-- VIEWS: "Res Partner"
        - Model·········: res_partner
        - Base Addons···: contacts
    - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -->

    <!-- Form view for "res_partner" -->
    <record id="view_res_partner_form" model="ir.ui.view">
        <field name="name">view.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@id='company']" position="attributes">
                <attribute name="required">type == 'contact'</attribute>
                <attribute name="invisible">country_code == 'DO' or not is_company</attribute>
            </xpath>

            <xpath expr="//field[@id='individual']" position="attributes">
                <attribute name="required">type == 'contact'</attribute>
                <attribute name="invisible">country_code == 'DO' or is_company</attribute>
            </xpath>

            <xpath expr="//field[@id='individual']" position="after">

                <field id="company" class="text-break" name="name" default_focus="1"
                       placeholder="e.g. Lumber Inc or RNC e.g. 101673656"
                       required="type == 'contact'" invisible="country_code != 'DO' or not is_company"/>

                <field id="individual" class="text-break" name="name" default_focus="1"
                       placeholder="e.g. Brandom Freeman or Cedula e.g. 00166273568"
                       required="type == 'contact'" invisible="country_code != 'DO' or is_company"/>
            </xpath>

        </field>
    </record>

</odoo>